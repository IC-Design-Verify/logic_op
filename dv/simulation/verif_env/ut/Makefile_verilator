# =============================================================================
# Verilator Makefile for the logic_op UVM testbench
# -----------------------------------------------------------------------------
# UVM library: the official Accellera UVM shipped in ../../../../uvm-verilator/
#   (chipsalliance/uvm-verilator, IEEE 1800.2-2020, the "UVM 1.2 for Verilator"
#    branch), compiled *in* by Verilator -- no simulator-bundled UVM is used.
#
# Run from this directory (dv/simulation/verif_env/ut):
#
#   make                 # verilate + build  (alias: build / uvm)
#   make run             # run logic_op_smoke_test
#   make run TEST=logic_op_and_test     # run a specific test
#   make wave            # run and dump tb.vcd (+trace)
#   make lint            # SystemVerilog elaboration check only (fast)
#   make clean
#
# Tests verified passing: smoke / and / or / xor / nxor
#   (each: UVM TEST PASSED, scoreboard [CHECK_PASS], 0 error / 0 fatal)
#
# Tool requirements: verilator (>=5.x) + verilator_coverage + g++/clang + make.
# No native toolchain?  Run it inside the official image:
#   docker run --rm --entrypoint bash \
#       -v "$REPO_ROOT":/work -w /work/dv/simulation/verif_env/ut \
#       -v "$REPO_ROOT/.ccache":/root/.ccache verilator/verilator:latest make run
# =============================================================================

# ---- Paths -------------------------------------------------------------------
# Repo root = the .../dv parent; UVM source lives at <repo>/uvm-verilator.
export PROJ_HOME  := $(shell pwd | sed -e 's/^\(.*\)\/dv\>.*/\1/')
export LIGHT_ROOT := $(shell pwd | sed -e 's/^\(.*ut\>\).*/\1/')

TOP      := logic_op_tb_top
OBJ_DIR  := obj_dir
EXE      := $(OBJ_DIR)/V$(TOP)

UVM_DIR  := $(PROJ_HOME)/uvm-verilator
UVM_SRC  := $(UVM_DIR)/src
UVM_DPI  := $(UVM_SRC)/dpi/uvm_dpi.cc          # UVM's own DPI/VPI implementation
DPI_CPP  := $(LIGHT_ROOT)/logic_op/env/reference_model/logic_op_dpi.cpp  # DUT ref-model DPI

# Verilator build filelist (UVM source + RTL + packages + tb_top, in dep order;
# deliberately excludes the VCS `logic_op_test` program block -- run_test() is
# launched from logic_op_tb_top under the -DVL_RUN_TEST guard instead).
FILELIST := filelist_vlt.f

# ---- Tools -------------------------------------------------------------------
VERILATOR          ?= verilator
VERILATOR_COVERAGE ?= verilator_coverage

TEST   ?= logic_op_smoke_test
EXTRA  ?=
STDBUF ?= stdbuf -oL

# ---- Flags (shared by build & lint) -----------------------------------------
#   -DVL_RUN_TEST            : logic_op_tb_top calls run_test() (no program top)
#   -DDEMO_MAKEFILE          : enable $dumpfile/$dumpvars in tb_top
#   -DUVM_PACKER_MAX_BYTES   : match the original VCS Makefile define
BASE_FLAGS  = --Mdir $(OBJ_DIR) --top-module $(TOP) --timescale 1ns/1ps
BASE_FLAGS += -Wall -Wno-fatal
BASE_FLAGS += -DVL_RUN_TEST -DDEMO_MAKEFILE -DUVM_PACKER_MAX_BYTES=1500000
BASE_FLAGS += -f $(FILELIST)

# --binary = --main --exe --build --timing (auto C++ main + timing for phases)
BUILD_FLAGS  = --binary -j 16 --vpi --trace-vcd --trace-depth 5

# ---- Targets ----------------------------------------------------------------
.PHONY: all build uvm run uvm-run wave uvm-wave lint clean uvm-clean help

all: build

help:
	@echo "logic_op UVM TB on Verilator  (UVM = uvm-verilator/, chipsalliance 1800.2)"
	@echo "  make                       build (verilate + compile)"
	@echo "  make run [TEST=name]       run a test (default: $(TEST))"
	@echo "  make wave [TEST=name]      run with +trace -> tb.vcd"
	@echo "  make lint                  SystemVerilog elaboration check"
	@echo "  make clean"
	@echo "  UVM source : $(UVM_DIR)"
	@echo "  Filelist   : $(FILELIST)"
	@echo "  Pass-through: make EXTRA='--trace-fst'  (or any verilator options)"

build uvm:
	@mkdir -p logs out
	@echo "-- VERILATE + BUILD (Accellera UVM via uvm-verilator/, top=$(TOP)) --"
	@bash -c 'set -o pipefail; \
	  $(VERILATOR) $(BUILD_FLAGS) $(BASE_FLAGS) $(DPI_CPP) $(UVM_DPI) $(EXTRA) \
	    2>&1 | tee logs/uvm_build.log'
	@echo
	@echo "Executable: $(EXE)"
	@echo "Run:        make run   (TEST=$(TEST))"

run uvm-run: build
	@mkdir -p logs out
	$(STDBUF) $(EXE) +UVM_TESTNAME=$(TEST) 2>&1 | tee logs/uvm_run.log

wave uvm-wave: build
	@mkdir -p logs out
	$(STDBUF) $(EXE) +UVM_TESTNAME=$(TEST) +trace 2>&1 | tee logs/uvm_run.log
	@echo "Waveform: tb.vcd"

# Fast SV-only elaboration check (no C++ build).
lint:
	@mkdir -p logs
	@bash -c 'set -o pipefail; \
	  $(VERILATOR) --lint-only $(BASE_FLAGS) $(EXTRA) 2>&1 | tee logs/lint.log'

clean uvm-clean:
	-rm -rf $(OBJ_DIR) logs/uvm_build.log logs/uvm_run.log logs/lint.log tb.vcd hierarchy.txt out
