export PROJ_HOME           := $(shell pwd | sed -e 's/^\(.*\)\/dv\>.*/\1/')
export LIGHT_ROOT          := $(shell pwd | sed -e 's/^\(.*ut\>\).*/\1/')


all: comp so run

so:
	gcc -Wall -m64 -g -fPIC -I${VCS_HOME}/include ${VCS_HOME}/include/svdpi.h -shared -o logic_op_dpi.so \
		./logic_op/env/reference_model/logic_op_dpi.c

comp:
	vcs -debug_access -full64 -sverilog -kdb \
		-l comp.log \
		-timescale=1ns/1ps \
		-ntb_opts uvm-1.2 +define+UVM_PACKER_MAX_BYTES=1500000 +define+DEMO_MAKEFILE \
		-f ./logic_op/filelist/tb.f -f ./logic_op/filelist/tc.f \
		-f ./logic_op/filelist/rtl.f \
		-top logic_op_tb_top -top logic_op_test

run:
	./simv -l simv.log +UVM_TESTNAME=logic_op_smoke_test -sv_lib logic_op_dpi

clean:
	rm -rf verdi* comp.log simv* vc_hdrs.h csrc out hierarchy.txt ucli* tr_db.log *xml *log *fsdb novas*

clean_all: clean
	rm -rf env filelist model  reg_model  sequences  tb_top  tests  uvc logic_op common


ifneq ($(words $(CURDIR)),1)
  $(error Unsupported: GNU Make cannot build in directories containing spaces, build elsewhere: '$(CURDIR)')
endif

# 优先使用 VERILATOR_ROOT 下的工具; 否则用 PATH 中的
ifeq ($(VERILATOR_ROOT),)
  VERILATOR          = verilator
  VERILATOR_COVERAGE = verilator_coverage
else
  export VERILATOR_ROOT
  VERILATOR          = $(VERILATOR_ROOT)/bin/verilator
  VERILATOR_COVERAGE = $(VERILATOR_ROOT)/bin/verilator_coverage
endif

# ------- 输入源: filelist 或命令行直接列文件 -------
#   FILELIST 非空  -> verilator ... -f <FILELIST>
#   FILELIST 为空   -> verilator ... <SOURCES>
FILELIST ?= -f ./logic_op/filelist/tb.f -f ./logic_op/filelist/tc.f -f ./logic_op/filelist/rtl.f
SOURCES  ?= xor_.v tb.v
ifneq ($(FILELIST),)
  VERILATOR_INPUT = $(FILELIST)
else
  VERILATOR_INPUT = $(SOURCES)
endif
TOP = logic_op_tb_top

# ------- Verilator 选项 -------
# --binary = --main --exe --build --timing: 自动生成 C++ main + 构建可执行
VERILATOR_FLAGS += --binary -j
VERILATOR_FLAGS += --Mdir obj_dir                  # 生成目录
VERILATOR_FLAGS += --trace-vcd --trace-depth 3     # VCD 波形 (RTL $dumpfile 控制)
VERILATOR_FLAGS += --assert                        # SV 断言
VERILATOR_FLAGS += --coverage                      # 覆盖率插桩 (结束自动写 coverage.dat)
VERILATOR_FLAGS += -x-assign fast                  # x 优化(提速)
VERILATOR_FLAGS += -Wall -Wno-fatal                # lint 提示但不断言失败
VERILATOR_FLAGS += --top-module $(TOP)                # SystemVerilog 顶层

# 可在命令行追加: make EXTRA="--trace-fst"
EXTRA ?=

# ------- UVM 目标 -------
# 使用官方 Verilator 兼容 UVM 移植版 (nodpi: 纯 SV, 无需 C++/VPI)
#   uvm_pkg_all_v2017_1_0_nodpi.svh 复制自 verilator-master/test_regress/t/uvm/
#   (Apache-2.0, UVM 1.2 官方代码, 由 Verilator 团队拼接为单文件)
# 另有 dpi 变体: 需 --vpi + uvm_dpi.cc (见 verilator-master/test_regress/t/t_uvm_hello_all_v2017_1_0_dpi.py)
UVM_PKG    = /home/IC_verify/verilator/test_regress/t/uvm/uvm_pkg_all_v2017_1_0_nodpi.svh
UVM_SRCS   = $(UVM_PKG) $(VERILATOR_INPUT)
UVM_FLAGS  = --binary -j --Mdir obj_dir_uvm
UVM_FLAGS += --trace-vcd --trace-depth 3 --coverage
UVM_FLAGS += -DNO_STIM          # 关闭 top.sv 内嵌激励, 改由 UVM driver 驱动
UVM_FLAGS += -Wno-fatal
UVM_FLAGS += --top-module $(TOP)  # UVM 模式顶层是测试台
UVM_FLAGS += +incdir+/home/IC_verify/verilator/test_regress/t/uvm

# 生成 + 构建 UVM 可执行 (不运行)
uvm:
	@echo
	@echo "-- VERILATE + BUILD (UVM) --"
	@bash -c 'set -o pipefail; $(VERILATOR) $(UVM_FLAGS) $(EXTRA) $(UVM_SRCS) 2>&1 | tee verilator_comp.log'
	@echo
	@echo "-- DONE --------------------------------"
	@echo "UVM 可执行: obj_dir_uvm/Vtb_top"
	@echo "运行仿真:   make uvm-run   (+trace 开波形)"
	@echo

# 运行 UVM 仿真
uvm-run: uvm
	@mkdir -p logs
	obj_dir_uvm/Vtb_top

# 带波形运行 UVM
uvm-wave: uvm
	@mkdir -p logs
	obj_dir_uvm/Vtb_top +trace
	@echo "波形: logs/vlt_dump_uvm.vcd"

uvm-clean:
	-rm -rf obj_dir_uvm logs/vlt_dump_uvm.vcd


# ------- DPI-C 目标 -------
# 演示: SV 通过 import "DPI-C" 调用 C++ 函数 (dpi/dpi_helpers.cpp)
# Verilator 自动生成 Vtop__Dpi.h (含 svdpi.h 与函数原型), 并编译链接 C++ 文件
DPI_SRCS   = ${LIGHT_ROOT}/logic_op/env/reference_model/logic_op_dpi.c
DPI_FLAGS  = --binary -j 16 --Mdir obj_dir_dpi
DPI_FLAGS += --trace --trace-depth 3 --coverage
DPI_FLAGS += -Wall -Wno-fatal -Wno-ASSIGNIN
DPI_FLAGS += --top-module $(TOP)

# 生成 + 构建 DPI 可执行 (不运行); 日志写入 logs/dpi_build.log
# 源文件: 用 filelist (含 top.sv + rtl/*.sv) + C++ 实现
dpi:
	@mkdir -p logs
	@echo
	@echo "-- VERILATE + BUILD (DPI-C) --"
	@bash -c 'set -o pipefail; $(VERILATOR) $(DPI_FLAGS) $(EXTRA) $(DPI_SRCS) $(UVM_SRCS) 2>&1 | tee verilator_comp.log'
	@echo
	@echo "-- DONE ---------------------------"
	@echo "编译日志:     logs/dpi_build.log"
	@echo "DPI 头文件:   obj_dir_dpi/Vtop__Dpi.h (自动生成)"
	@echo "DPI 可执行:   obj_dir_dpi/Vtop"
	@echo "运行仿真:     make dpi-run"
	@echo

# 运行 DPI 仿真
# 期望输出: [DPI-C] hello from SV via DPI-C
#           DPI-C dpi_crc32(0xDEADBEEF) = 0x1a5a601f
#   (反射版 CRC-32 对整数 0xDEADBEEF 从 LSB 处理, 等价于 zlib.crc32(bytes.fromhex('efbeadde')))
dpi-run: dpi
	@mkdir -p logs
	obj_dir_dpi/Vtop

dpi-clean:
	-rm -rf obj_dir_dpi logs/dpi_build.log

# 默认目标: 只生成 + 构建，不运行仿真
default: build

build:
	@echo
	@echo "-- VERILATE + BUILD (输入: $(if $(FILELIST),-f $(FILELIST),$(SOURCES))) --"
	$(VERILATOR) $(VERILATOR_FLAGS) $(EXTRA) $(VERILATOR_INPUT)
	@echo
	@echo "-- DONE ------------------------------------------"
	@echo "模型/可执行已生成: obj_dir/V$(TOP) (可执行), obj_dir/V$(TOP).h, obj_dir/V$(TOP).mk"
	@echo "运行仿真:  make run    (生成 coverage.dat)"
	@echo "带波形:    make wave   (生成 logs/vlt_dump.vcd + coverage.dat)"
	@echo

# 可选: 运行仿真（不生成波形）
run: build
	@mkdir -p logs
	obj_dir/V$(TOP)

# 可选: 带波形运行
wave: build
	@mkdir -p logs
	obj_dir/V$(TOP) +trace
	@echo "波形: logs/vlt_dump.vcd (GTKWave / Surfer 打开)"

# 覆盖率注释报告（对 coverage.dat 生成可读报告）
coverage: run
	@rm -rf logs/annotated
	$(VERILATOR_COVERAGE) --annotate logs/annotated coverage.dat
	@echo "覆盖率报告: logs/annotated/"

# 只做 lint
lint:
	$(VERILATOR) --lint-only -Wall --top-module $(TOP) $(VERILATOR_INPUT)

clean:
	-rm -rf obj_dir logs coverage.dat *.log *.dmp *.vpd core

